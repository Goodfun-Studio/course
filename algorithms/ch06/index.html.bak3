<!doctype html>
<html lang="zh">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>快速排序：分治法的杰作</title>
<link rel="stylesheet" href="../lib/engine.css">
<link rel="expect" href="#bar" blocking="render">
</head>
<body>
<script src="../lib/engine.js"></script>
<script src="../lib/math.js"></script>
<script src="audio/zh/timings.js"></script>
<script>
'use strict';
const CHAPTER = { number: 6, title: '快速排序：分治法的杰作', language: 'zh', minutes: 7 };

/* ---------- 颜色 ---------- */
const UNSORTED = '#8a8f98';
const PIVOT = '#f5a623';
const COMPARING = '#4facfe';
const LESS = '#43e97b';
const GREATER = '#f093fb';
const SORTED = '#43e97b';
const SWAP = '#f5576c';

/* ---------- 数组可视化：柱状图 ---------- */
function drawBars(parent, arr, { x = 300, y = 550, w = 1000, colors = null, labels = null, pivotIndex = -1 } = {}) {
  const g = G(parent);
  const n = arr.length;
  const barW = w / n;
  const maxH = 350;
  const maxVal = Math.max(...arr);
  
  arr.forEach((val, i) => {
    const h = (val / maxVal) * maxH;
    const bx = x + i * barW;
    const by = y - h;
    
    // 柱子
    const color = colors ? colors[i] : UNSORTED;
    const bar = mk('rect', {
      x: bx + 2,
      y: by,
      width: barW - 4,
      height: h,
      fill: color,
      rx: 3
    }, g);
    
    // 数值标签
    if (labels === null || labels[i]) {
      T(g, String(val), {
        x: bx + barW / 2,
        y: by - 8,
        size: 18,
        fill: COL.chalk,
        anchor: 'middle'
      });
    }
    
    // pivot 标记
    if (i === pivotIndex) {
      const arrow = path(g, `M${bx + barW/2} ${y + 35} L${bx + barW/2} ${y + 15}`, {
        stroke: PIVOT,
        'stroke-width': 3,
        'marker-end': 'url(#arrowhead)',
        opacity: 0
      });
      tw(arrow, { opacity: 1 }, 0.1, 0.4);
      
      T(g, 'pivot', {
        x: bx + barW / 2,
        y: y + 55,
        size: 20,
        fill: PIVOT,
        anchor: 'middle',
        weight: 600,
        o: 0
      });
    }
  });
  
  return g;
}

// 定义箭头标记
function setupArrowMarker(parent) {
  const defs = mk('defs', {}, parent);
  const marker = mk('marker', {
    id: 'arrowhead',
    markerWidth: 10,
    markerHeight: 10,
    refX: 5,
    refY: 3,
    orient: 'auto'
  }, defs);
  mk('polygon', {
    points: '0 0, 10 3, 0 6',
    fill: PIVOT
  }, marker);
}

/* ---------- Beats ---------- */
const BEATS = [

['intro', '问题呈现', () => {
  const p = panel(0);
  setupArrowMarker(p);
  
  const title = T(p, '快速排序 QuickSort', { x: 800, y: 120, size: 56, weight: 700, anchor: 'middle', o: 0 });
  tw(title, { o: 1, y: 110 }, 0.1, 0.8, out);
  
  const sub = T(p, '分治法的经典代表', { x: 800, y: 180, size: 32, fill: COL.dim, anchor: 'middle', o: 0 });
  tw(sub, { o: 1 }, 0.6, 0.6);
  
  // 展示一个无序数组
  const arr = [7, 2, 9, 4, 1, 6, 8, 3, 5];
  const bars = drawBars(p, arr, { y: 550 });
  tw(bars, { o: 1 }, 1.2, 0.8, out);
  
  const note = T(p, '把这些数字从小到大排序', { x: 800, y: 650, size: 28, fill: COL.dim, anchor: 'middle', o: 0 });
  tw(note, { o: 1 }, 2.5, 0.6);
  
  const inventor = T(p, 'Tony Hoare, 1960', { x: 800, y: 730, size: 24, fill: '#f5a623', anchor: 'middle', o: 0 });
  tw(inventor, { o: 1 }, 14, 0.6);
}],

['divide_conquer', '分治策略', () => {
  const p = panel(0);
  
  const head = T(p, '分治法三步走', { x: 800, y: 130, size: 46, weight: 600, anchor: 'middle', o: 0 });
  tw(head, { o: 1 }, 0.1, 0.6, out);
  
  const steps = [
    ['1. 分解', 'Divide', '把大问题分成小问题'],
    ['2. 递归', 'Conquer', '递归解决小问题'],
    ['3. 合并', 'Combine', '合并子问题的解']
  ];
  
  steps.forEach(([num, eng, desc], i) => {
    const yBase = 260 + i * 150;
    
    const box = mk('rect', {
      x: 350,
      y: yBase - 35,
      width: 900,
      height: 100,
      rx: 12,
      fill: 'none',
      stroke: '#4facfe',
      'stroke-width': 2,
      opacity: 0
    }, p);
    tw(box, { opacity: 0.8 }, 1 + i * 0.6, 0.5);
    
    const numT = T(p, num, {
      x: 420,
      y: yBase + 5,
      size: 32,
      fill: '#4facfe',
      weight: 600,
      o: 0
    });
    tw(numT, { o: 1 }, 1 + i * 0.6, 0.5);
    
    const engT = T(p, eng, {
      x: 600,
      y: yBase + 5,
      size: 28,
      fill: COL.chalk,
      o: 0
    });
    tw(engT, { o: 1 }, 1.2 + i * 0.6, 0.5);
    
    const descT = T(p, desc, {
      x: 850,
      y: yBase + 5,
      size: 24,
      fill: COL.dim,
      o: 0
    });
    tw(descT, { o: 1 }, 1.4 + i * 0.6, 0.5);
  });
  
  const magic = T(p, '快速排序的聪明之处：工作在分解阶段，不需要合并！', {
    x: 800,
    y: 730,
    size: 26,
    fill: '#43e97b',
    anchor: 'middle',
    o: 0
  });
  tw(magic, { o: 1 }, 11, 0.6);
}],

['partition', 'Partition：分区操作', () => {
  const p = panel(0);
  setupArrowMarker(p);
  
  const head = T(p, '核心：Partition（分区）', { x: 800, y: 130, size: 46, weight: 600, anchor: 'middle', o: 0 });
  tw(head, { o: 1 }, 0.1, 0.6, out);
  
  // 展示分区概念
  const arr = [4, 2, 7, 1, 9, 3, 8, 5, 6];
  const pivotIdx = 4; // 选9作为pivot
  
  const colors = arr.map((v, i) => i === pivotIdx ? PIVOT : UNSORTED);
  const bars = drawBars(p, arr, { y: 380, colors, pivotIndex: pivotIdx });
  tw(bars, { o: 1 }, 0.8, 0.6);
  
  // 说明
  const step1 = T(p, '① 选一个基准值（pivot）', { x: 300, y: 520, size: 26, fill: COL.chalk, o: 0 });
  tw(step1, { o: 1 }, 2, 0.5);
  
  const step2 = T(p, '② 重新排列：比pivot小的放左边，大的放右边', { x: 300, y: 570, size: 26, fill: COL.chalk, o: 0 });
  tw(step2, { o: 1 }, 5, 0.5);
  
  const step3 = T(p, '③ pivot就在最终位置了', { x: 300, y: 620, size: 26, fill: COL.chalk, o: 0 });
  tw(step3, { o: 1 }, 10, 0.5);
  
  // 分区后的效果
  const afterArr = [4, 2, 7, 1, 3, 5, 6, 8, 9];
  const afterColors = afterArr.map((v, i) => {
    if (i === 8) return SORTED; // pivot在最终位置
    if (i < 6) return LESS;
    return GREATER;
  });
  const afterBars = drawBars(p, afterArr, { y: 720, colors: afterColors, labels: afterArr.map(() => true) });
  put(afterBars, { o: 0 });
  tw(afterBars, { o: 1 }, 13, 0.8, out);
  
  // 标注
  const leftLabel = T(p, '≤ pivot', { x: 450, y: 760, size: 22, fill: LESS, anchor: 'middle', o: 0 });
  tw(leftLabel, { o: 1 }, 14, 0.5);
  
  const rightLabel = T(p, '> pivot', { x: 1100, y: 760, size: 22, fill: GREATER, anchor: 'middle', o: 0 });
  tw(rightLabel, { o: 1 }, 14, 0.5);
}],

['partition_demo', 'Partition 演示', () => {
  const p = panel(0);
  setupArrowMarker(p);
  
  const head = T(p, '双指针扫描法', { x: 800, y: 120, size: 42, weight: 600, anchor: 'middle', o: 0 });
  tw(head, { o: 1 }, 0.1, 0.6, out);
  
  // 初始数组
  const arr = [4, 2, 9, 1, 7, 3, 8, 5, 6];
  const n = arr.length;
  const pivotVal = arr[n - 1]; // 选最后一个：6
  
  const x0 = 250, y0 = 400, barW = 100;
  
  // 画柱子和标签
  const bars = [];
  const labels = [];
  arr.forEach((val, i) => {
    const color = i === n - 1 ? PIVOT : UNSORTED;
    const h = val * 35;
    const bx = x0 + i * barW + 5;
    const by = y0 - h;
    
    const bar = mk('rect', {
      x: bx,
      y: by,
      width: barW - 10,
      height: h,
      fill: color,
      rx: 3
    }, p);
    bars.push(bar);
    put(bar, { x: bx, c_fill: color });
    
    const label = T(p, String(val), {
      x: bx + (barW - 10) / 2,
      y: by - 10,
      size: 20,
      fill: COL.chalk,
      anchor: 'middle',
      o: 0
    });
    labels.push(label);
  });
  
  tw(bars[n - 1], { o: 1 }, 0.5, 0.5);
  tw(labels[n - 1], { o: 1 }, 0.5, 0.5);
  bars.slice(0, -1).forEach((b, i) => {
    tw(b, { o: 1 }, 0.7 + i * 0.08, 0.4);
    tw(labels[i], { o: 1 }, 0.7 + i * 0.08, 0.4);
  });
  
  // 指针 i 和 j
  let iPos = -1;
  const iArrow = path(p, '', { stroke: LESS, 'stroke-width': 3, opacity: 0 });
  const iLabel = T(p, 'i', { x: 0, y: y0 + 60, size: 24, fill: LESS, anchor: 'middle', weight: 600, o: 0 });
  
  const jArrow = path(p, '', { stroke: COMPARING, 'stroke-width': 3, opacity: 0 });
  const jLabel = T(p, 'j', { x: 0, y: y0 + 90, size: 24, fill: COMPARING, anchor: 'middle', weight: 600, o: 0 });
  
  function movePointer(arrow, label, idx, t0) {
    const px = x0 + idx * barW + barW / 2;
    arrow.setAttribute('d', `M${px} ${y0 + 25} L${px} ${y0 + 5}`);
    tw(arrow, { opacity: 1 }, t0, 0.3);
    tw(label, { x: px, o: 1 }, t0, 0.3);
  }
  
  // 模拟分区过程
  let t = 3;
  const code = T(p, '扫描：j < pivot 时，交换 arr[i] 和 arr[j]，i++', {
    x: 800,
    y: 510,
    size: 22,
    fill: COL.dim,
    anchor: 'middle',
    o: 0
  });
  tw(code, { o: 1 }, 2.5, 0.5);
  
  // j 从0开始扫描
  for (let j = 0; j < n - 1; j++) {
    movePointer(jArrow, jLabel, j, t);
    
    if (arr[j] < pivotVal) {
      iPos++;
      movePointer(iArrow, iLabel, iPos, t + 0.3);
      
      // 交换动画
      if (iPos !== j) {
        // 变色
        tw(bars[iPos], { c_fill: SWAP }, t + 0.5, 0.2);
        tw(bars[j], { c_fill: SWAP }, t + 0.5, 0.2);
        
        // 交换位置
        const xI = st(bars[iPos]).x;
        const xJ = st(bars[j]).x;
        tw(bars[iPos], { x: xJ }, t + 0.5, 0.4, io);
        tw(bars[j], { x: xI }, t + 0.5, 0.4, io);
        tw(labels[iPos], { x: xJ + (barW - 10) / 2 }, t + 0.5, 0.4, io);
        tw(labels[j], { x: xI + (barW - 10) / 2 }, t + 0.5, 0.4, io);
        
        // 交换数组中的引用
        [bars[iPos], bars[j]] = [bars[j], bars[iPos]];
        [labels[iPos], labels[j]] = [labels[j], labels[iPos]];
        [arr[iPos], arr[j]] = [arr[j], arr[iPos]];
        
        // 变回小于颜色
        tw(bars[iPos], { c_fill: LESS }, t + 0.9, 0.2);
        tw(bars[j], { c_fill: LESS }, t + 0.9, 0.2);
      } else {
        tw(bars[j], { c_fill: LESS }, t + 0.5, 0.3);
      }
      
      t += 1.2;
    } else {
      t += 0.8;
    }
  }
  
  // 最后把pivot换到中间
  const finalSwap = T(p, '最后：交换 pivot 到位置 i+1', {
    x: 800,
    y: 570,
    size: 22,
    fill: '#f5a623',
    anchor: 'middle',
    o: 0
  });
  tw(finalSwap, { o: 1 }, t, 0.4);
  
  const pivotFinalPos = iPos + 1;
  tw(bars[pivotFinalPos], { c_fill: SWAP }, t + 0.5, 0.2);
  tw(bars[n - 1], { c_fill: SWAP }, t + 0.5, 0.2);
  
  // 交换位置
  const xPivotFinal = st(bars[pivotFinalPos]).x;
  const xPivotCurrent = st(bars[n - 1]).x;
  tw(bars[pivotFinalPos], { x: xPivotCurrent }, t + 0.5, 0.5, io);
  tw(bars[n - 1], { x: xPivotFinal }, t + 0.5, 0.5, io);
  tw(labels[pivotFinalPos], { x: xPivotCurrent + (barW - 10) / 2 }, t + 0.5, 0.5, io);
  tw(labels[n - 1], { x: xPivotFinal + (barW - 10) / 2 }, t + 0.5, 0.5, io);
  
  [bars[pivotFinalPos], bars[n - 1]] = [bars[n - 1], bars[pivotFinalPos]];
  [labels[pivotFinalPos], labels[n - 1]] = [labels[n - 1], labels[pivotFinalPos]];
  
  tw(bars[pivotFinalPos], { c_fill: SORTED }, t + 1, 0.3);
  tw(bars[n - 1], { c_fill: SORTED }, t + 1, 0.3);
  
  const done = T(p, '分区完成！', {
    x: 800,
    y: 710,
    size: 36,
    fill: '#43e97b',
    weight: 600,
    anchor: 'middle',
    o: 0
  });
  tw(done, { o: 1, s: 1.1 }, t + 2, 0.6, out);
}],

['pivot_choice', 'Pivot 选择策略', () => {
  const p = panel(0);
  
  const head = T(p, 'Pivot 怎么选？', { x: 800, y: 130, size: 46, weight: 600, anchor: 'middle', o: 0 });
  tw(head, { o: 1 }, 0.1, 0.6, out);
  
  const strategies = [
    ['首元素', 'arr[0]', '简单，但有序数组会退化', '#f5576c'],
    ['尾元素', 'arr[n-1]', '同样简单，同样有风险', '#f5576c'],
    ['随机', 'random', '避免最坏情况，实际常用', '#43e97b'],
    ['三数取中', 'median(arr[0], arr[n/2], arr[n-1])', '首、中、尾取中位数，效果好', '#4facfe']
  ];
  
  strategies.forEach(([name, code, desc, color], i) => {
    const yBase = 240 + i * 120;
    
    const box = mk('rect', {
      x: 200,
      y: yBase - 40,
      width: 1200,
      height: 90,
      rx: 10,
      fill: 'none',
      stroke: color,
      'stroke-width': 2,
      opacity: 0
    }, p);
    tw(box, { opacity: 0.7 }, 0.8 + i * 0.5, 0.4);
    
    const nameT = T(p, name, {
      x: 280,
      y: yBase + 5,
      size: 28,
      fill: color,
      weight: 600,
      o: 0
    });
    tw(nameT, { o: 1 }, 0.9 + i * 0.5, 0.4);
    
    const codeT = T(p, code, {
      x: 480,
      y: yBase + 5,
      size: 22,
      fill: COL.chalk,
      font: 'ui-monospace, Menlo, monospace',
      o: 0
    });
    tw(codeT, { o: 1 }, 1.0 + i * 0.5, 0.4);
    
    const descT = T(p, desc, {
      x: 280,
      y: yBase + 40,
      size: 20,
      fill: COL.dim,
      o: 0
    });
    tw(descT, { o: 1 }, 1.1 + i * 0.5, 0.4);
  });
  
  const best = T(p, '工程实践：随机或三数取中', {
    x: 800,
    y: 730,
    size: 28,
    fill: '#43e97b',
    anchor: 'middle',
    weight: 600,
    o: 0
  });
  tw(best, { o: 1 }, 20, 0.6);
}],

['recursion', '递归调用', () => {
  const p = panel(0);
  
  const head = T(p, '递归处理左右子数组', { x: 800, y: 130, size: 46, weight: 600, anchor: 'middle', o: 0 });
  tw(head, { o: 1 }, 0.1, 0.6, out);
  
  // 递归树
  const levels = [
    { arr: '[7,2,9,4,1,6,8,3,5]', y: 250, x: 800, color: '#4facfe' },
    { arr: '[2,4,1,3]', y: 380, x: 500, color: '#43e97b' },
    { arr: '[9,6,8,5]', y: 380, x: 1100, color: '#f093fb' },
    { arr: '[1]', y: 510, x: 350, color: COL.dim },
    { arr: '[4,2,3]', y: 510, x: 650, color: COL.dim },
    { arr: '[6,5]', y: 510, x: 1000, color: COL.dim },
    { arr: '[9,8]', y: 510, x: 1200, color: COL.dim }
  ];
  
  levels.forEach((node, i) => {
    const box = mk('rect', {
      x: node.x - 90,
      y: node.y - 25,
      width: 180,
      height: 50,
      rx: 8,
      fill: mix(node.color, COL.board, 0.3),
      stroke: node.color,
      'stroke-width': 2,
      opacity: 0
    }, p);
    tw(box, { opacity: 1 }, 0.5 + i * 0.3, 0.4, out);
    
    const text = T(p, node.arr, {
      x: node.x,
      y: node.y + 8,
      size: 18,
      fill: COL.chalk,
      anchor: 'middle',
      font: 'ui-monospace, Menlo, monospace',
      o: 0
    });
    tw(text, { o: 1 }, 0.6 + i * 0.3, 0.4);
  });
  
  // 连线
  const edges = [
    [800, 275, 500, 355],
    [800, 275, 1100, 355],
    [500, 405, 350, 485],
    [500, 405, 650, 485],
    [1100, 405, 1000, 485],
    [1100, 405, 1200, 485]
  ];
  
  edges.forEach(([x1, y1, x2, y2], i) => {
    const line = path(p, `M${x1} ${y1} L${x2} ${y2}`, {
      stroke: COL.dim,
      'stroke-width': 2,
      opacity: 0
    });
    tw(line, { opacity: 0.5 }, 1 + i * 0.2, 0.3);
  });
  
  const base = T(p, '递归边界：0 或 1 个元素时已有序', {
    x: 800,
    y: 650,
    size: 26,
    fill: COL.dim,
    anchor: 'middle',
    o: 0
  });
  tw(base, { o: 1 }, 12, 0.6);
  
  const power = T(p, '分治的威力：每次规模减半', {
    x: 800,
    y: 710,
    size: 28,
    fill: '#43e97b',
    anchor: 'middle',
    weight: 600,
    o: 0
  });
  tw(power, { o: 1 }, 15, 0.6);
}],

['best_case', '最好情况', () => {
  const p = panel(0);
  
  const head = T(p, '最好情况：O(n log n)', { x: 800, y: 130, size: 46, weight: 600, anchor: 'middle', o: 0 });
  tw(head, { o: 1 }, 0.1, 0.6, out);
  
  // 完美平衡的递归树
  const treeY = 220;
  const levelGap = 110;
  
  // 第一层
  const root = mk('circle', { cx: 800, cy: treeY, r: 35, fill: '#4facfe', opacity: 0 }, p);
  tw(root, { opacity: 1 }, 0.8, 0.4, out);
  T(p, 'n', { x: 800, y: treeY + 6, size: 24, fill: COL.board, anchor: 'middle', weight: 600 });
  
  // 第二层
  [600, 1000].forEach((x, i) => {
    const line = path(p, `M800 ${treeY + 35} L${x} ${treeY + levelGap - 35}`, {
      stroke: COL.dim,
      'stroke-width': 2,
      opacity: 0
    });
    tw(line, { opacity: 0.6 }, 1.2, 0.3);
    
    const node = mk('circle', { cx: x, cy: treeY + levelGap, r: 32, fill: '#43e97b', opacity: 0 }, p);
    tw(node, { opacity: 1 }, 1.5 + i * 0.2, 0.4, out);
    T(p, 'n/2', { x, y: treeY + levelGap + 6, size: 20, fill: COL.board, anchor: 'middle', weight: 600 });
  });
  
  // 第三层
  [450, 600, 850, 1000].forEach((x, i) => {
    const px = x < 700 ? 600 : 1000;
    const line = path(p, `M${px} ${treeY + levelGap + 32} L${x} ${treeY + levelGap * 2 - 28}`, {
      stroke: COL.dim,
      'stroke-width': 2,
      opacity: 0
    });
    tw(line, { opacity: 0.6 }, 2.0 + i * 0.15, 0.3);
    
    const node = mk('circle', { cx: x, cy: treeY + levelGap * 2, r: 28, fill: '#f093fb', opacity: 0 }, p);
    tw(node, { opacity: 1 }, 2.3 + i * 0.15, 0.4, out);
    T(p, 'n/4', { x, y: treeY + levelGap * 2 + 5, size: 18, fill: COL.board, anchor: 'middle', weight: 600 });
  });
  
  // 说明
  const balanced = T(p, '每次对半分，树高 = log n', {
    x: 800,
    y: 600,
    size: 28,
    fill: COL.chalk,
    anchor: 'middle',
    o: 0
  });
  tw(balanced, { o: 1 }, 4, 0.5);
  
  const total = T(p, '每层 n 个元素，总共 O(n log n)', {
    x: 800,
    y: 660,
    size: 28,
    fill: '#43e97b',
    anchor: 'middle',
    weight: 600,
    o: 0
  });
  tw(total, { o: 1 }, 11, 0.6);
}],

['worst_case', '最坏情况', () => {
  const p = panel(0);
  
  const head = T(p, '最坏情况：O(n²)', { x: 800, y: 130, size: 46, weight: 600, anchor: 'middle', o: 0 });
  tw(head, { o: 1 }, 0.1, 0.6, out);
  
  // 退化成链表的树
  const chainX = 700, chainY = 240;
  const gap = 80;
  
  const nodes = ['n', 'n-1', 'n-2', 'n-3', '...', '2', '1'];
  nodes.forEach((label, i) => {
    if (i > 0) {
      const line = path(p, `M${chainX} ${chainY + (i - 1) * gap + 28} L${chainX} ${chainY + i * gap - 28}`, {
        stroke: COL.dim,
        'stroke-width': 2,
        opacity: 0
      });
      tw(line, { opacity: 0.6 }, 0.8 + i * 0.3, 0.3);
    }
    
    const r = i === 4 ? 8 : 28;
    const node = mk('circle', {
      cx: chainX,
      cy: chainY + i * gap,
      r,
      fill: i === 4 ? COL.dim : '#f5576c',
      opacity: 0
    }, p);
    tw(node, { opacity: 1 }, 1.0 + i * 0.3, 0.4, out);
    
    if (i !== 4) {
      T(p, label, {
        x: chainX,
        y: chainY + i * gap + 6,
        size: i > 4 ? 20 : 22,
        fill: COL.board,
        anchor: 'middle',
        weight: 600
      });
    }
  });
  
  const reason = T(p, '每次只能分出一个元素', {
    x: 950,
    y: 320,
    size: 26,
    fill: COL.chalk,
    o: 0
  });
  tw(reason, { o: 1 }, 3, 0.5);
  
  const example = T(p, '例：已排序数组 + 首元素做 pivot', {
    x: 950,
    y: 370,
    size: 24,
    fill: COL.dim,
    o: 0
  });
  tw(example, { o: 1 }, 3.5, 0.5);
  
  const formula = T(p, '树高 = n，总时间 O(n²)', {
    x: 800,
    y: 710,
    size: 32,
    fill: '#f5576c',
    anchor: 'middle',
    weight: 600,
    o: 0
  });
  tw(formula, { o: 1, s: 1.05 }, 15, 0.6, out);
}],

['average_case', '平均情况', () => {
  const p = panel(0);
  
  const head = T(p, '平均情况：O(n log n)', { x: 800, y: 130, size: 46, weight: 600, anchor: 'middle', o: 0 });
  tw(head, { o: 1 }, 0.1, 0.6, out);
  
  const key = T(p, '关键：只要不总是极端值，性能就好', {
    x: 800,
    y: 230,
    size: 32,
    fill: COL.chalk,
    anchor: 'middle',
    o: 0
  });
  tw(key, { o: 1 }, 1, 0.6);
  
  // 画一个不完美但还行的树
  const y0 = 340;
  const nodes = [
    { x: 800, y: y0, r: 35, label: 'n', color: '#4facfe' },
    { x: 550, y: y0 + 100, r: 30, label: '3n/4', color: '#43e97b' },
    { x: 1050, y: y0 + 100, r: 25, label: 'n/4', color: '#f093fb' },
    { x: 400, y: y0 + 200, r: 26, label: 'n/2', color: '#f5a623' },
    { x: 650, y: y0 + 200, r: 20, label: 'n/8', color: COL.dim },
    { x: 950, y: y0 + 200, r: 18, label: 'n/8', color: COL.dim },
    { x: 1150, y: y0 + 200, r: 15, label: 'n/16', color: COL.dim }
  ];
  
  nodes.forEach((node, i) => {
    const circle = mk('circle', {
      cx: node.x,
      cy: node.y,
      r: node.r,
      fill: node.color,
      opacity: 0
    }, p);
    tw(circle, { opacity: 1 }, 1.5 + i * 0.25, 0.4, out);
    
    T(p, node.label, {
      x: node.x,
      y: node.y + 5,
      size: node.r > 20 ? 18 : 14,
      fill: COL.board,
      anchor: 'middle',
      weight: 600
    });
  });
  
  // 连线
  [[800, y0 + 35, 550, y0 + 70], [800, y0 + 35, 1050, y0 + 75],
   [550, y0 + 130, 400, y0 + 174], [550, y0 + 130, 650, y0 + 180],
   [1050, y0 + 125, 950, y0 + 182], [1050, y0 + 125, 1150, y0 + 185]
  ].forEach(([x1, y1, x2, y2], i) => {
    const line = path(p, `M${x1} ${y1} L${x2} ${y2}`, {
      stroke: COL.dim,
      'stroke-width': 2,
      opacity: 0
    });
    tw(line, { opacity: 0.5 }, 2 + i * 0.15, 0.3);
  });
  
  const math = T(p, '数学期望：E[T(n)] = O(n log n)', {
    x: 800,
    y: 650,
    size: 28,
    fill: '#43e97b',
    anchor: 'middle',
    weight: 600,
    o: 0
  });
  tw(math, { o: 1 }, 14, 0.6);
  
  const fast = T(p, '实际中：常数因子小，比归并排序快', {
    x: 800,
    y: 710,
    size: 26,
    fill: COL.dim,
    anchor: 'middle',
    o: 0
  });
  tw(fast, { o: 1 }, 16, 0.6);
}],

['in_place', '原地排序', () => {
  const p = panel(0);
  
  const head = T(p, '空间复杂度：O(log n)', { x: 800, y: 130, size: 46, weight: 600, anchor: 'middle', o: 0 });
  tw(head, { o: 1 }, 0.1, 0.6, out);
  
  const inPlace = T(p, '快速排序是原地排序（In-place）', {
    x: 800,
    y: 240,
    size: 36,
    fill: '#43e97b',
    anchor: 'middle',
    weight: 600,
    o: 0
  });
  tw(inPlace, { o: 1 }, 1, 0.6);
  
  const why = T(p, '不需要额外的 O(n) 数组', {
    x: 800,
    y: 310,
    size: 30,
    fill: COL.chalk,
    anchor: 'middle',
    o: 0
  });
  tw(why, { o: 1 }, 2, 0.5);
  
  const how = T(p, '直接在原数组上交换元素', {
    x: 800,
    y: 370,
    size: 30,
    fill: COL.chalk,
    anchor: 'middle',
    o: 0
  });
  tw(how, { o: 1 }, 3, 0.5);
  
  const stack = T(p, '只用递归栈的 O(log n) 空间', {
    x: 800,
    y: 430,
    size: 30,
    fill: COL.chalk,
    anchor: 'middle',
    o: 0
  });
  tw(stack, { o: 1 }, 4, 0.5);
  
  // 对比表格
  const compY = 540;
  const compRows = [
    ['', '快速排序', '归并排序'],
    ['时间', 'O(n log n)*', 'O(n log n)'],
    ['空间', 'O(log n)', 'O(n)'],
    ['原地', '✓', '✗']
  ];
  
  compRows.forEach((row, ri) => {
    row.forEach((cell, ci) => {
      const isHeader = ri === 0 || ci === 0;
      const t = T(p, cell, {
        x: 400 + ci * 300,
        y: compY + ri * 50,
        size: isHeader ? 26 : 24,
        fill: isHeader ? '#4facfe' : COL.chalk,
        anchor: ci === 0 ? 'start' : 'middle',
        weight: isHeader ? 600 : 400,
        o: 0
      });
      tw(t, { o: 1 }, 6 + ri * 0.3 + ci * 0.1, 0.4);
    });
  });
  
  const note = T(p, '*平均情况', {
    x: 400,
    y: 750,
    size: 20,
    fill: COL.dim,
    o: 0
  });
  tw(note, { o: 1 }, 9, 0.4);
}],

['stability', '稳定性', () => {
  const p = panel(0);
  
  const head = T(p, '快速排序不稳定', { x: 800, y: 130, size: 46, weight: 600, anchor: 'middle', o: 0 });
  tw(head, { o: 1 }, 0.1, 0.6, out);
  
  const what = T(p, '相等元素的相对顺序可能改变', {
    x: 800,
    y: 240,
    size: 32,
    fill: COL.chalk,
    anchor: 'middle',
    o: 0
  });
  tw(what, { o: 1 }, 1.5, 0.6);
  
  // 例子
  const ex1 = T(p, '排序前：3ᵃ  5  2  3ᵇ  1', {
    x: 800,
    y: 340,
    size: 30,
    fill: COL.dim,
    anchor: 'middle',
    font: 'ui-monospace, Menlo, monospace',
    o: 0
  });
  tw(ex1, { o: 1 }, 3, 0.5);
  
  const ex2 = T(p, '排序后：1  2  3ᵇ  3ᵃ  5  （可能）', {
    x: 800,
    y: 410,
    size: 30,
    fill: '#f5576c',
    anchor: 'middle',
    font: 'ui-monospace, Menlo, monospace',
    o: 0
  });
  tw(ex2, { o: 1 }, 5, 0.5);
  
  const arrow = path(p, 'M800 360 L800 390', {
    stroke: COL.dim,
    'stroke-width': 2,
    'marker-end': 'url(#arrowhead-dim)',
    opacity: 0
  });
  setupArrowMarker(p);
  const defs = p.querySelector('defs');
  const marker2 = mk('marker', {
    id: 'arrowhead-dim',
    markerWidth: 10,
    markerHeight: 10,
    refX: 5,
    refY: 3,
    orient: 'auto'
  }, defs);
  mk('polygon', { points: '0 0, 10 3, 0 6', fill: COL.dim }, marker2);
  tw(arrow, { opacity: 0.6 }, 4, 0.5);
  
  const when = T(p, '何时需要稳定性？', {
    x: 800,
    y: 520,
    size: 28,
    fill: '#4facfe',
    anchor: 'middle',
    weight: 600,
    o: 0
  });
  tw(when, { o: 1 }, 7.5, 0.5);
  
  const cases = T(p, '多关键字排序、UI 列表排序等', {
    x: 800,
    y: 570,
    size: 24,
    fill: COL.dim,
    anchor: 'middle',
    o: 0
  });
  tw(cases, { o: 1 }, 8.5, 0.5);
  
  const alt = T(p, '需要稳定性时 → 归并排序', {
    x: 800,
    y: 680,
    size: 28,
    fill: '#43e97b',
    anchor: 'middle',
    weight: 600,
    o: 0
  });
  tw(alt, { o: 1 }, 11, 0.6);
}],

['summary', '总结', () => {
  const p = panel(0);
  
  const head = T(p, '快速排序：分治法的杰作', { x: 800, y: 110, size: 48, weight: 700, anchor: 'middle', o: 0 });
  tw(head, { o: 1 }, 0.1, 0.8, out);
  
  const points = [
    ['核心', 'Partition + 递归'],
    ['平均', 'O(n log n)'],
    ['最坏', 'O(n²)'],
    ['空间', 'O(log n) 原地'],
    ['稳定性', '不稳定'],
    ['实战', '通常最快']
  ];
  
  points.forEach(([label, value], i) => {
    const yBase = 230 + i * 75;
    
    const labelT = T(p, label, {
      x: 400,
      y: yBase,
      size: 28,
      fill: '#4facfe',
      weight: 600,
      o: 0
    });
    tw(labelT, { o: 1 }, 1 + i * 0.5, 0.4);
    
    const valueT = T(p, value, {
      x: 600,
      y: yBase,
      size: 26,
      fill: COL.chalk,
      o: 0
    });
    tw(valueT, { o: 1 }, 1.2 + i * 0.5, 0.4);
  });
  
  const real = T(p, 'C qsort, Java Arrays.sort, Python sorted', {
    x: 800,
    y: 710,
    size: 24,
    fill: COL.dim,
    anchor: 'middle',
    font: 'ui-monospace, Menlo, monospace',
    o: 0
  });
  tw(real, { o: 1 }, 20, 0.6);
  
  const praise = T(p, '掌握快速排序，就掌握了排序的精髓', {
    x: 800,
    y: 770,
    size: 28,
    fill: '#43e97b',
    anchor: 'middle',
    weight: 600,
    o: 0
  });
  tw(praise, { o: 1, s: 1.05 }, 23, 0.8, out);
}],

].map(([id, title, run]) => ({ id, title, run }));

// 归一化并调用 boot
window.BEATS = BEATS.map(b => {
  if (!b.dur && window.TIMINGS && window.TIMINGS[b.id]) {
    b.dur = window.TIMINGS[b.id].dur;
  }
  return b;
});

boot();
</script>
</body>
</html>
